{
  "version": 2,
  "builds": [
    {
      "src": "app.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "250mb",
        "runtime": "python3.12",
        "includeFiles": "{app.py,requirements.txt,models/**,.streamlit/**}"
      }
    }
  ],
  "routes": [
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "app.py" }
  ],
  "installCommand": "pip install --upgrade pip && pip install -r requirements.txt",
  "functions": {
    "app.py": {
      "memory": 1024,
      "maxDuration": 60
    }
  }
}
